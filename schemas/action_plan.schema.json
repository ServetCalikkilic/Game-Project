{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cse377.local/schemas/action_plan.schema.json",
  "title": "RTSActionPlan",
  "description": "Structured plan proposed by the AI Strategic Commander. It is a proposal only: Unity shows it to the player (Approve/Reject), then GameActionValidator re-checks it against the authoritative state before any Fusion command is issued.",
  "type": "object",
  "required": ["summary", "confidence", "actions"],
  "additionalProperties": false,
  "properties": {
    "summary": { "type": "string", "minLength": 1, "maxLength": 400 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "limitations": {
      "type": "string",
      "maxLength": 250,
      "description": "Set when a tool failed or data was stale/incomplete, so confidence is limited."
    },
    "evidence": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "description": "RAG source IDs (units.json / technologies.json / rules.md) that support the plan.",
      "items": { "type": "string", "pattern": "^(unit|tech|rule|bld)_[a-z0-9_]+_v[0-9]+$" }
    },
    "actions": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/action" }
    }
  },
  "$defs": {
    "unit_type": {
      "enum": ["Worker", "Spearman", "Archer", "Raider", "Guardian", "Ram"]
    },
    "building_type": {
      "enum": ["House", "Barracks", "ArcheryYard", "Stable"]
    },
    "tech_id": {
      "enum": ["tech_age2_iron_age_v1", "tech_sharpened_tools_v1", "tech_longbow_training_v1", "tech_forged_blades_v1", "tech_reinforced_plating_v1"]
    },
    "target_zone": {
      "enum": ["BaseCenter", "NorthGate", "SouthGate", "EastGate", "WestGate", "FarmArea", "Forest", "GoldMine"]
    },
    "action": {
      "type": "object",
      "required": ["action_type", "reason"],
      "additionalProperties": false,
      "properties": {
        "action_type": { "enum": ["TRAIN_UNIT", "BUILD", "MOVE_GROUP", "RESEARCH"] },
        "unit_type": { "$ref": "#/$defs/unit_type" },
        "building_type": { "$ref": "#/$defs/building_type" },
        "tech_id": { "$ref": "#/$defs/tech_id" },
        "count": { "type": "integer", "minimum": 1, "maximum": 20 },
        "target_zone": { "$ref": "#/$defs/target_zone" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 250 }
      },
      "allOf": [
        {
          "if": { "properties": { "action_type": { "const": "TRAIN_UNIT" } }, "required": ["action_type"] },
          "then": { "required": ["unit_type", "count"], "not": { "anyOf": [{ "required": ["building_type"] }, { "required": ["tech_id"] }, { "required": ["target_zone"] }] } }
        },
        {
          "if": { "properties": { "action_type": { "const": "BUILD" } }, "required": ["action_type"] },
          "then": { "required": ["building_type"], "not": { "anyOf": [{ "required": ["unit_type"] }, { "required": ["tech_id"] }, { "required": ["count"] }] } }
        },
        {
          "if": { "properties": { "action_type": { "const": "MOVE_GROUP" } }, "required": ["action_type"] },
          "then": { "required": ["target_zone"], "not": { "anyOf": [{ "required": ["building_type"] }, { "required": ["tech_id"] }, { "required": ["count"] }] } }
        },
        {
          "if": { "properties": { "action_type": { "const": "RESEARCH" } }, "required": ["action_type"] },
          "then": { "required": ["tech_id"], "not": { "anyOf": [{ "required": ["unit_type"] }, { "required": ["building_type"] }, { "required": ["count"] }, { "required": ["target_zone"] }] } }
        }
      ]
    }
  }
}
